# Copie este arquivo para .env:
#   cp .env.example .env
#
# Use uma passphrase forte com pelo menos 12 caracteres. A CLI carrega o .env
# automaticamente a partir do diretorio --root. Uma variavel com o mesmo nome
# ja exportada no shell tem precedencia.
#
# Nao versione nem compartilhe o .env. Perder a passphrase impede abrir o cofre;
# mantenha uma copia offline segura. Aspas simples ou duplas sao aceitas.
WATERMARK_GENERATOR_PASSPHRASE='substitua-por-uma-passphrase-forte-e-unica'

# Sessao local com um unico comando: run session-local
WATERMARK_LOCAL_MODEL='/caminho/para/modelo-local'
WATERMARK_INTENSITY_TABLE='private/intensity.json'
WATERMARK_SESSION_PROVIDER='openai'

# Parametros publicos. A tabela deve conter WATERMARK_PERIOD valores.
WATERMARK_PERIOD=64
WATERMARK_CONTEXT_WIDTH=4
WATERMARK_GAMMA=0.5
WATERMARK_STRENGTH=1.0
WATERMARK_MINIMUM_TOKENS=100
